# fastlane auto-loads this file. Copy it to fastlane/.env (gitignored) and
# uncomment the values you need locally. Real values live in 1Password:
#
#   ASC_KEY_ID / ASC_ISSUER_ID / .p8 -> "AppStore Connect: fastlane-ci"
#   MATCH_PASSWORD                   -> "fastlane-ci: match"
#
# Example with the 1Password CLI:
#   ASC_KEY_ID=$(op item get "AppStore Connect: fastlane-ci" --fields Benutzername)
#   ASC_ISSUER_ID=$(op item get "AppStore Connect: fastlane-ci" --fields "Issue ID")
#   MATCH_PASSWORD=$(op item get "fastlane-ci: match" --fields password --reveal)

# ASC_KEY_ID=
# ASC_ISSUER_ID=
# Either a path to the .p8 ...
# ASC_KEY_PATH=
# ... or its (optionally base64-encoded) content.
# ASC_KEY_CONTENT=

# MATCH_GIT_URL=git@github.com:cedricziel/certificates.git
# MATCH_PASSWORD=

# Both optional — unset means the build stays telemetry-off. Real values
# live wherever you keep the SignalDB homelab/apps ingest coordinates.
# SIGNALDB_OTEL_ENDPOINT=
# SIGNALDB_OTEL_HEADERS=
