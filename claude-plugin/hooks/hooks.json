{
  "description": "Append this session's prompts and responses to a robot-notes note under conversations/<actor>/<session_id>. No-ops unless ROBOT_NOTES_BASE_URL and ROBOT_NOTES_API_KEY are set.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/log_conversation.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/log_conversation.py\""
          }
        ]
      }
    ]
  }
}
