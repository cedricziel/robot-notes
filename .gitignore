# Serena tooling state (project-local cache + user-specific config)
.serena/cache/
.serena/project.local.yml

# Dart / Flutter build outputs (anticipated)
.dart_tool/
.dart_frog/
.packages
.pub-cache/
.pub/
build/

# Generated by `dart_frog build` and the workspace tooling, EXCEPT the two
# root/app-level ones below, which are committed on purpose: dart_frog
# build's own resolver doesn't apply an inline dependency_overrides block
# correctly, so the flutter_otel git-dependency pins live in these files
# instead (a pattern dart_frog's own examples use for the same reason).
**/pubspec_overrides.yaml
!/pubspec_overrides.yaml
!/app/pubspec_overrides.yaml

# Flutter platform build outputs
**/ios/Pods/
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/macos/Pods/
**/android/.gradle/
**/android/captures/
**/android/local.properties

# IDE / editor
.idea/
.vscode/
*.iml
*.swp
.DS_Store

# Server runtime data (created at runtime, never committed)
/data/
/.dev-data/
/.e2e-data/
/.e2e-server.stdin
server/data/

# Logs
*.log

# fastlane (app/fastlane): local env, generated docs, run reports
**/fastlane/.env
**/fastlane/README.md
**/fastlane/report.xml
**/fastlane/test_output/
**/.bundle/
**/vendor/bundle/

# bundler binstubs generated on CI (bundle binstubs cocoapods)
app/bin/
