# Serena tooling state (project-local cache + user-specific config)
.serena/cache/
.serena/project.local.yml

# Dart / Flutter build outputs (anticipated)
.dart_tool/
.dart_frog/
.packages
.pub-cache/
.pub/
build/

# Generated by `dart_frog build` and the workspace tooling.
**/pubspec_overrides.yaml

# Flutter platform build outputs
**/ios/Pods/
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/macos/Pods/
**/android/.gradle/
**/android/captures/
**/android/local.properties

# IDE / editor
.idea/
.vscode/
*.iml
*.swp
.DS_Store

# Server runtime data (created at runtime, never committed)
/data/
/.dev-data/
/.e2e-data/
/.e2e-server.stdin
server/data/

# Logs
*.log

# fastlane (app/fastlane): local env, generated docs, run reports
**/fastlane/.env
**/fastlane/README.md
**/fastlane/report.xml
**/fastlane/test_output/
**/.bundle/
**/vendor/bundle/

# bundler binstubs generated on CI (bundle binstubs cocoapods)
app/bin/
